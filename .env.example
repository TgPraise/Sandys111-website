# Copy this file to .env and fill in real values.
# See ADMIN.md for full setup instructions.

# Leave these two blank to run the admin panel in local demo mode
# (events/bookings/orders only visible in your own browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Change this before sharing the live site with anyone.
VITE_ADMIN_PASSWORD=sandys111admin

# Leave blank to fall back to mailto (opens the guest's email app) instead
# of emailing you directly. See ADMIN.md "Email notifications" section.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
